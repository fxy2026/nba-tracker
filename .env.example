# Optional configuration. Main browsing pages start without API keys or a database.
# Leave unused values blank. Never commit real keys or passwords.

# Optional, server-only BallDontLie key for /api/salary (requires provider access).
# Leave blank for empty salary data. Never expose provider keys with NEXT_PUBLIC_.
BALLDONTLIE_API_KEY=

# Optional legacy replay storage compatibility only.
# Public replay pages and admin replay management UI have been retired.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional, server-only password for /admin and related protected APIs.
# Leave blank unless using admin tools; this example supplies no password.
ADMIN_PASSWORD=

# Optional absolute site origin for server-side self-fetches.
# Defaults to the Vercel production URL, or http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=
